# Amadeus API (free tier: https://developers.amadeus.com/)
# Sign up at https://developers.amadeus.com/register
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# Kiwi.com Tequila API (free tier: https://tequila.kiwi.com/)
# Sign up at https://tequila.kiwi.com/
KIWI_API_KEY=your_kiwi_api_key

# Email configuration (Gmail)
# Enable "Less secure app access" or use App Password
# See: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_app_password

# Optional: Custom email recipient (defaults to EMAIL_USER)
EMAIL_RECIPIENT=recipient@example.com

# GitHub Actions (automatically set, no action needed)
GITHUB_TOKEN=""
GITHUB_REPOSITORY=""

# Optional: Debug mode
DEBUG=false
